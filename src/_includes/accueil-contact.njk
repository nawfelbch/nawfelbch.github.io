{#- Bloc contact : coordonnées, rappel du barème (données réelles de l'app) et formulaire (e-mail). -#}
{%- set L = prix.libelles -%}
<section id="contact" aria-labelledby="contact-title">
  <div class="contact-wrap">
    <div class="contact-info reveal">
      <div class="stag">Nous contacter</div>
      <h2 id="contact-title" class="s-title">Une question ?<br><span class="acc">Parlons-en</span></h2>
      <p>Une question sur un trajet, un véhicule particulier ou un besoin professionnel ? Nous vous répondons et vous orientons vers la bonne solution, que votre véhicule roule ou non.</p>
      <div class="cinfo-item">
        <div class="cinfo-ico" aria-hidden="true">📍</div>
        <div>
          <div class="cinfo-label">Zone couverte</div>
          <div class="cinfo-val">France métropolitaine · Europe sur demande</div>
        </div>
      </div>
      <div class="cinfo-item">
        <div class="cinfo-ico" aria-hidden="true">📞</div>
        <div>
          <div class="cinfo-label">Téléphone</div>
          <div class="cinfo-val"><a class="lien-fort" href="tel:{{ site.telephoneIntl }}">{{ site.telephone }}</a></div>
        </div>
      </div>
      <div class="cinfo-item">
        <div class="cinfo-ico" aria-hidden="true">✉️</div>
        <div>
          <div class="cinfo-label">E-mail</div>
          <div class="cinfo-val"><a class="lien-fort" href="mailto:{{ site.email }}">{{ site.email }}</a></div>
        </div>
      </div>
      <div class="cinfo-item">
        <div class="cinfo-ico" aria-hidden="true">🕐</div>
        <div>
          <div class="cinfo-label">Disponibilité</div>
          <div class="cinfo-val">7j/7</div>
        </div>
      </div>
      <div class="rappel-tarifs">
        <div class="rappel-titre">Rappel tarifs</div>
        <div class="rappel-ligne"><span>Convoyage par chauffeur</span><strong>{{ L.convoyageKm }}/km</strong></div>
        <div class="rappel-ligne"><span>Plateau moto{% if L.plafondMoto %} (max. {{ L.plafondMoto }}){% endif %}</span><strong>{{ L.plateauMotoKm }}/km</strong></div>
        <div class="rappel-ligne"><span>Plateau voiture</span><strong>{{ L.plateauVoitureKm }}/km</strong></div>
        <div class="rappel-ligne"><span>Plateau utilitaire, caravane</span><strong>{{ L.plateauUtilitaireKm }}/km</strong></div>
        <div class="rappel-ligne"><span>Non roulant</span><strong>+ {{ L.nonRoulant }}</strong></div>
        <div class="rappel-ligne"><span>Minimum plateau</span><strong>{{ L.plateauMin }}</strong></div>
      </div>
    </div>

    <form id="contact-form" class="reveal" name="contact" method="POST" novalidate aria-label="Formulaire de contact">
      <input type="hidden" name="bot-field" />
      <div class="form-grid">
        <div class="field">
          <label for="c-prenom">Prénom</label>
          <input type="text" id="c-prenom" name="prenom" placeholder="Jean" autocomplete="given-name" required />
        </div>
        <div class="field">
          <label for="c-nom">Nom</label>
          <input type="text" id="c-nom" name="nom" placeholder="Dupont" autocomplete="family-name" required />
        </div>
        <div class="field full">
          <label for="c-email">E-mail</label>
          <input type="email" id="c-email" name="email" placeholder="jean.dupont@entreprise.fr" autocomplete="email" required />
        </div>
        <div class="field full">
          <label for="c-message">Message</label>
          <textarea id="c-message" name="message" placeholder="Votre question…" rows="5"></textarea>
        </div>
        <div class="field full">
          <button type="submit" class="btn btn-ghost btn-large">Poser ma question →</button>
        </div>
      </div>
    </form>
  </div>
  <div class="sec-cta"><a href="#simulateur" class="btn js-main-cta">Voir mon prix en 30 secondes</a></div>
</section>
