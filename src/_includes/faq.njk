{#- FAQ accessible : boutons natifs + région. Le même tableau `faq` produit les données FAQPage. -#}
<div class="faq-wrap">
  {%- for f in faq %}
  {%- set idq = "faq-" ~ (faqPrefixe or "q") ~ "-" ~ loop.index %}
  <div class="faq-item">
    <h3 class="faq-h">
      <button type="button" class="faq-q" aria-expanded="false" aria-controls="{{ idq }}">
        <span>{{ f.q }}</span>
        <span class="faq-arrow" aria-hidden="true">▾</span>
      </button>
    </h3>
    <div class="faq-a" id="{{ idq }}" role="region" aria-label="{{ f.q }}">{{ f.r }}</div>
  </div>
  {%- endfor %}
</div>
