<!DOCTYPE html>
{%- set canonique = (canonical or page.url) | absolu -%}
{%- set imageOg = (ogImage or "/assets/img/og-secoto.jpg") | absolu -%}
{%- set slugPage = slugUtm or (page.fileSlug if page.fileSlug else "accueil") -%}
<html lang="fr" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
  <meta name="robots" content="{{ robots or 'index, follow, max-image-preview:large, max-snippet:-1' }}">
  <link rel="canonical" href="{{ canonique }}">
  {%- if site.verification.google %}
  <meta name="google-site-verification" content="{{ site.verification.google }}">{% endif %}
  {%- if site.verification.bing %}
  <meta name="msvalidate.01" content="{{ site.verification.bing }}">{% endif %}

  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:locale" content="fr_FR">
  <meta property="og:site_name" content="SECOTO">
  <meta property="og:url" content="{{ canonique }}">
  <meta property="og:title" content="{{ ogTitle or title }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:image" content="{{ imageOg }}">
  <meta property="og:image:type" content="image/jpeg">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="SECOTO — transport de véhicules, prix en 30 secondes">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ ogTitle or title }}">
  <meta name="twitter:description" content="{{ description }}">
  <meta name="twitter:image" content="{{ imageOg }}">

  <link rel="icon" type="image/png" sizes="32x32" href="/assets/img/favicon-32.png">
  <link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png">
  <meta name="theme-color" content="#070b14">

  <link rel="preload" href="/assets/fonts/bebas-neue-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/dm-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/css/site.css?v={{ build.version }}">

  {%- include "schema.njk" %}
</head>
<body data-page="{{ slugPage }}">
  <a class="skip-link" href="#contenu">Aller au contenu</a>
  <div id="cursor-dot" aria-hidden="true"></div>
  <div id="cursor-ring" aria-hidden="true"></div>

  {% include "header.njk" %}

  <main id="contenu">
    {%- if fil and fil.length %}
    <nav class="fil" aria-label="Fil d’Ariane">
      <ol>
        <li><a href="/">Accueil</a></li>
        {%- for e in fil %}
        <li>{% if loop.last %}<span aria-current="page">{{ e.nom }}</span>{% else %}<a href="{{ e.url }}">{{ e.nom }}</a>{% endif %}</li>
        {%- endfor %}
      </ol>
    </nav>
    {%- endif %}
    {{ content | safe }}
  </main>

  {% include "footer.njk" %}

  <script id="secoto-bareme" type="application/json">{{ prix.bareme | json | safe }}</script>
  <script src="/assets/js/site.js?v={{ build.version }}" defer></script>
  {%- if simulateur %}
  <script src="/assets/js/simulateur.js?v={{ build.version }}" defer></script>
  {%- endif %}
</body>
</html>
